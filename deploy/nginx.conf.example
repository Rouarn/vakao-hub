# VaKao Hub 的 Nginx 配置（宝塔站点里粘贴到「配置文件」）
#
# 前台、后台、API 全部由同一个 Node 进程提供，所以这里只做一件事：整体反代。
# 下载产物额外走 X-Accel-Redirect：Node 负责鉴权与计数，Nginx 负责发字节。

server {
    listen 80;
    server_name dist.example.com;

    client_max_body_size 2g;

    # 下载产物：internal 表示只能被内部的 X-Accel-Redirect 命中，
    # 外部直接访问 /_files/... 会 404。
    location /_files/ {
        internal;
        alias /www/wwwroot/vakaohub/storage/;
    }

    location / {
        proxy_pass http://127.0.0.1:31888;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
