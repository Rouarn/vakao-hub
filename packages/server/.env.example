# ============================================================
# VaKao Hub 服务端环境变量示例
#
# 复制为 .env 后按需修改。每条都标注了：用途 / 是否必填 / 默认值 / 格式示例 / 取值来源。
# 默认值集中在 src/config/env.ts；未在该文件出现的键没有默认值可用。
# 注意：布尔项留空等价于使用默认值，但 PORT / DB_PORT / UPLOAD_MAX_BYTES 这类数值项
# 留空会被解析成 0（不是回落到默认值），不确定时就删掉整行而不是留空。
# 相对路径基于 server 进程工作目录。生产配置见 .env.production.example。
# ============================================================

# ---------- 服务 ----------

# NODE_ENV：运行模式，决定是否开启生产硬校验、是否关闭 Swagger。【可选】默认 development
# 示例：development | production | test
# 取值：本地开发用 development；上线必须 production（生产下强制 JWT_SECRET≥32 字符、ADMIN_PASSWORD≥8 位、DB_SYNCHRONIZE=false，并关闭 /api/docs）
NODE_ENV=development

# PORT：HTTP 监听端口。【可选】默认 3000
# 示例：3000
# 取值：自行指定，需与 Nginx 反代端口、防火墙放行一致（deploy/nginx.conf.example 反代到 127.0.0.1:3000）
PORT=3000

# HOST：HTTP 监听地址。【可选】默认 127.0.0.1
# 示例：127.0.0.1（只监听本机，前面挂 Nginx）| 0.0.0.0（所有网卡，直接对外）
# 取值：本项目按反代部署，一般保持默认；只有前面没有反代、需要直接对外监听时才改成 0.0.0.0
# HOST=127.0.0.1

# PUBLIC_BASE_URL：产物下载链接使用的对外基址。【可选】默认空（按请求头推导）
# 示例：https://dist.shixian.xyz（反向代理/上线后填写；不带 /api，也不要结尾斜杠）
# 取值：填站点对外 HTTPS 域名；留空时下载地址由 x-forwarded-proto/host 或 Host 头实时拼出，本地开发保持留空即可
PUBLIC_BASE_URL=

# CORS_ORIGINS：跨域来源白名单，逗号分隔。【可选】默认本地四个来源（5180/5200）
# 示例：https://admin.example.com,https://dist.example.com
# 取值：管理端与 API 不同域时列出管理端域名；同域部署（Nginx 反代 /api/）可留空，浏览器不会发起跨域请求
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5200,http://127.0.0.1:5200

# ---------- 认证与管理端 ----------

# JWT_SECRET：登录令牌（JWT）签名密钥。【必填】开发有内置兜底，生产无默认值且必须 ≥32 字符
# 示例：openssl rand -hex 32 生成的 64 位十六进制串
# 取值：自行生成；泄露等于会话可被伪造，更换后所有已签发令牌立即失效
JWT_SECRET=please-change-this-to-a-long-random-string

# JWT_EXPIRES_IN：登录令牌有效期。【可选】默认 12h
# 示例：30m | 12h | 7d
# 取值：按安全要求自行决定；过期后管理端需重新登录
JWT_EXPIRES_IN=12h

# ADMIN_USERNAME：首次启动时播种的管理员用户名。【可选】默认 admin
# 示例：admin
# 取值：自行指定；仅当该用户名在 hub_admin_users 中不存在时创建，已有账号不会被覆盖
ADMIN_USERNAME=admin

# ADMIN_PASSWORD：首次启动播种的管理员密码。【可选】开发默认 admin123456；生产必填且 ≥8 位
# 示例：至少 8 位的强密码（此处仅为示例格式，勿写真实密码）
# 取值：自行指定，只在首次创建管理员时生效；账号已存在时改这里无效，请用管理端「修改密码」
ADMIN_PASSWORD=admin123456

# ---------- MySQL ----------

# DB_HOST：MySQL 地址。【可选】默认 127.0.0.1
# 示例：127.0.0.1 | mysql.internal
# 取值：按数据库实际地址；deploy/mysql-init.sql.example 创建的账号只允许 127.0.0.1 登录
DB_HOST=127.0.0.1

# DB_PORT：MySQL 端口。【可选】默认 3306
# 示例：3306
# 取值：MySQL 实际监听端口
DB_PORT=3306

# DB_USER：数据库账号。【可选】默认 root
# 示例：vakao_hub（生产建议专用账号，不要用 root）
# 取值：deploy/mysql-init.sql.example 中 CREATE USER 的账号
DB_USER=root

# DB_PASSWORD：数据库密码。【可选】默认空
# 示例：与 mysql-init 脚本里 IDENTIFIED BY 的值一致
# 取值：deploy/mysql-init.sql.example 中设置；生产务必使用强密码，不要用 root 空密码
DB_PASSWORD=

# DB_NAME：数据库名。【可选】默认 vakao_hub
# 示例：vakao_hub
# 取值：需先按 deploy/mysql-init.sql.example 建库（utf8mb4）；应用只连库，不会自动创建库
DB_NAME=vakao_hub

# DB_SYNCHRONIZE：是否让 TypeORM 自动同步表结构。【可选】默认 development=true / production=false
# 示例：true | false
# 取值：开发期填 true 省去迁移；生产必须 false（启动时硬校验），结构变更走 pnpm migrate:run
DB_SYNCHRONIZE=true

# DB_MIGRATIONS_RUN：应用启动时是否自动执行未应用的迁移。【可选】默认 false
# 示例：true | false
# 取值：推荐保持 false 并手动执行 pnpm migrate:run（改动前可备份、失败可见）；设为 true 则每次启动自动迁移
DB_MIGRATIONS_RUN=false

# DB_LOGGING：是否输出 SQL 日志。【可选】默认 false
# 示例：true | false
# 取值：排查 SQL 时临时开 true，日常保持 false（日志量大且含参数）
DB_LOGGING=false

# ---------- 存储与上传 ----------

# STORAGE_DIR：安装包存放目录。【可选】默认 storage
# 示例：storage（相对 server 运行目录）| /data/vakaohub/storage（绝对路径）
# 取值：相对路径按进程工作目录解析（systemd 的 WorkingDirectory）；换盘时填绝对路径，需保证运行用户 www 有写权限
STORAGE_DIR=storage

# WEB_DIR：静态站点根目录，其下 site/ 为下载页、admin/ 为管理端。【可选】默认 web
WEB_DIR=web

# UPLOAD_MAX_BYTES：单个产物的上传上限（字节）。【可选】默认 2147483648（2GB）
# 示例：2147483648
# 取值：按最大安装包调整；Nginx client_max_body_size 必须 ≥ 此值（deploy 配置为 2g），否则大包会先被反代拒绝
UPLOAD_MAX_BYTES=2147483648

# ---------- 客户端事件 ----------

# EVENT_RETENTION_DAYS：客户端上报事件的保留天数。【可选】默认 0（永久保留，不启用清理）
# 示例：30 | 90（正整数；0 表示永久保留）
# 取值：当前保持 0 即关闭清理；要开启就改成天数后重启，超期记录会被物理删除且不可恢复，统计回溯范围随之缩短
# EVENT_RETENTION_DAYS=0
